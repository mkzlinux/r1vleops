# WhatsApp number clients reach for negotiation (digits only, with country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=263713619305

# Leave both empty to run in local demo mode (data saved in the browser).
# Fill them to switch the app to Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Cloudflare backend (recommended). Set NEXT_PUBLIC_DATA_BACKEND=cloudflare to enable. ---
# Server-only values: set them in Vercel's Environment Variables, never commit real ones.
NEXT_PUBLIC_DATA_BACKEND=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=525d53e5-6419-44ac-bc39-ded8b4104e12
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_TOKEN_ID=
R2_BUCKET=r1vleops-order-files
OPS_PASSWORD=
OPS_SESSION_SECRET=

# --- Online payments (each switches on when set) ---
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
USDC_WALLET_BASE=
USDC_WALLET_BSC=
USDC_WALLET_XRPL=
SITE_URL=https://r1vleops.vercel.app
